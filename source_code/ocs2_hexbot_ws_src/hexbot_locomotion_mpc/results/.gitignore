!batch_paper_forward_v1/analysis/figures/
batch_paper_forward_v1/analysis/figures/*
!batch_paper_forward_v1/analysis/figures/*.pdf
!batch_paper_forward_v1/analysis/figures/*.svg
!batch_paper_forward_v1/analysis/figures/plot_manifest.json
