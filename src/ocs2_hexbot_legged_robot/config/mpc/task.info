centroidalModelType             1      // 0: FullCentroidalDynamics, 1: Single Rigid Body Dynamics

legged_robot_interface
{
  verbose                               false
  useAnalyticalGradientsDynamics        false
  useAnalyticalGradientsConstraints     false
  enableTarsusBranchConstraint          true
  tarsusBranchMargin                    0.15
}

model_settings
{
  positionErrorGain             4.0
  propulsionForceScale          2.0
  propulsionForceResponseTime   0.15
  propulsionForceMaxAcceleration 0.6
  movingTangentialForcePenaltyScale 0.08
  movingForceDeadzoneVelocity   0.005
  phaseTransitionStanceTime     0.2

  verboseCppAd                  true
  recompileLibrariesCppAd       false
  modelFolderCppAd              /tmp/ocs2_hexbot

  jointNames
  {
    [0] coxa_joint_RR
    [1] femur_joint_RR
    [2] tarsus_joint_RR
    [3] coxa_joint_RM
    [4] femur_joint_RM
    [5] tarsus_joint_RM
    [6] coxa_joint_RF
    [7] femur_joint_RF
    [8] tarsus_joint_RF
    [9] coxa_joint_LR
    [10] femur_joint_LR
    [11] tarsus_joint_LR
    [12] coxa_joint_LM
    [13] femur_joint_LM
    [14] tarsus_joint_LM
    [15] coxa_joint_LF
    [16] femur_joint_LF
    [17] tarsus_joint_LF
  }

  contactNames3DoF
  {
    [0] foot_RR
    [1] foot_RM
    [2] foot_RF
    [3] foot_LR
    [4] foot_LM
    [5] foot_LF
  }
}

swing_trajectory_config
{
  liftOffVelocity               0.15
  touchDownVelocity            -0.30
  swingHeight                   0.03
  swingTimeScale                0.15
  tripodForwardStride           0.06
  tripodMaxLinearX              0.05
}

sqp
{
  nThreads                              3
  dt                                    0.015
  sqpIteration                          1
  deltaTol                              1e-4
  g_max                                 1e-2
  g_min                                 1e-6
  inequalityConstraintMu                0.1
  inequalityConstraintDelta             5.0
  projectStateInputEqualityConstraints  true
  printSolverStatistics                 true
  printSolverStatus                     false
  printLinesearch                       false
  useFeedbackPolicy                     true
  integratorType                        RK2
  threadPriority                        50
}

ipm
{
  nThreads                              3
  dt                                    0.015
  ipmIteration                          1
  deltaTol                              1e-4
  g_max                                 10.0
  g_min                                 1e-6
  computeLagrangeMultipliers            true
  printSolverStatistics                 true
  printSolverStatus                     false
  printLinesearch                       false
  useFeedbackPolicy                     true
  integratorType                        RK2
  threadPriority                        50

  initialBarrierParameter               1e-4
  targetBarrierParameter                1e-4
  barrierLinearDecreaseFactor           0.2
  barrierSuperlinearDecreasePower       1.5
  barrierReductionCostTol               1e-3
  barrierReductionConstraintTol         1e-3

  fractionToBoundaryMargin              0.995
  usePrimalStepSizeForDual              false

  initialSlackLowerBound                1e-4
  initialDualLowerBound                 1e-4
  initialSlackMarginRate                1e-2
  initialDualMarginRate                 1e-2
}

ddp
{
  algorithm                       SLQ

  nThreads                        3
  threadPriority                  50

  maxNumIterations                1
  minRelCost                      1e-1
  constraintTolerance             5e-3

  displayInfo                     false
  displayShortSummary             false
  checkNumericalStability         false
  debugPrintRollout               false

  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  maxNumStepsPerSecond            10000
  timeStep                        0.015
  backwardPassIntegratorType      ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms          true

  useFeedbackPolicy               false

  strategy                        LINE_SEARCH
  lineSearch
  {
    minStepLength                 1e-2
    maxStepLength                 1.0
    hessianCorrectionStrategy     DIAGONAL_SHIFT
    hessianCorrectionMultiple     1e-5
  }
}

rollout
{
  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  timeStep                        0.015
  integratorType                  ODE45
  maxNumStepsPerSecond            10000
  checkNumericalStability         false
}

mpc
{
  timeHorizon                     0.5
  solutionTimeWindow              -1
  coldStart                       false

  debugPrint                      false

  mpcDesiredFrequency             50
  mrtDesiredFrequency             400
}

