  <version>0.1.0</version>
  <description>Parallel v2 locomotion stack for Hexbot phase-1 closed-loop tripod walking.</description>

  <maintainer email="devnull@example.com">Workspace Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

